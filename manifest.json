{
  "manifest_version": 3,
  "name": "DeepBrim",
  "version": "1.3.0",
  "description": "DeepSeek 网页版上下文仪表盘：看清每次对话的 Token 用量。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
